FROM rust:bookworm AS prover-builder

RUN apt-get update && apt-get install -y \
  pkg-config \
  libssl-dev \
  clang \
  lld \
  curl \
  git \
  protobuf-compiler \
  build-essential \
  && rm -rf /var/lib/apt/lists/*
RUN curl -L https://sp1.succinct.xyz | bash && /root/.sp1/bin/sp1up
ENV PATH="/root/.sp1/bin:${PATH}"

WORKDIR /app
COPY carnot-circuit /app/carnot-circuit
RUN cargo build --release --manifest-path /app/carnot-circuit/script/Cargo.toml --bin carnot

FROM node:22-slim

WORKDIR /app
RUN apt-get update && apt-get install -y python3 make g++ && rm -rf /var/lib/apt/lists/*

# Copy SDK and keeper so local file dependency resolves.
COPY carnot-sdk /app/carnot-sdk
COPY carnot-keeper /app/carnot-keeper

# Build SDK artifacts consumed by @carnot/sdk file dependency.
WORKDIR /app/carnot-sdk
RUN yarn install --production=false && yarn build

# Copy linux-built prover binary into the image.
COPY --from=prover-builder /app/carnot-circuit/target/release/carnot /prover/carnot
RUN chmod +x /prover/carnot

WORKDIR /app/carnot-keeper
RUN yarn install --frozen-lockfile --production=false
RUN yarn build

ENV NODE_ENV=production
ENV SP1_PROVER_BINARY=/prover/carnot

CMD ["node", "dist/index.js"]
